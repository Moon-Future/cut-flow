{
  "name": "cut-flow",
  "version": "0.1.0",
  "description": "本地优先的开发者短视频生产工作流",
  "author": "Cut Flow Contributors",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "vite --config studio/vite.config.ts",
    "preview": "vite --config studio/vite.config.ts",
    "build": "vite build --config studio/vite.config.ts",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:dev": "pnpm desktop:build && electron .",
    "desktop:pack": "pnpm build && pnpm desktop:build && electron-builder --win nsis",
    "remotion:studio": "remotion studio src/remotion/index.ts",
    "validate": "tsx scripts/validate-project.ts",
    "render": "tsx scripts/render-video.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "@remotion/bundler": "4.0.495",
    "@remotion/cli": "4.0.495",
    "@remotion/player": "4.0.495",
    "@remotion/renderer": "4.0.495",
    "@remotion/transitions": "4.0.495",
    "@vitejs/plugin-react": "4.6.0",
    "msedge-tts": "^2.0.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.495",
    "tsx": "^4.0.0",
    "vite": "7.0.0",
    "zod": "4.3.6",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "main": "dist/desktop/main.cjs",
  "build": {
    "appId": "com.cutflow.desktop",
    "productName": "Cut Flow",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "asarUnpack": [
      "node_modules/@remotion/**",
      "node_modules/remotion/**"
    ],
    "files": [
      "dist/desktop/**",
      "dist/studio/**",
      "src/**",
      "studio/**",
      "scripts/**",
      "projects/**",
      "index.html",
      "package.json",
      "remotion.config.ts"
    ],
    "extraResources": [
      {
        "from": "projects",
        "to": "seed-projects"
      },
      {
        "from": "projects",
        "to": "runtime/projects"
      },
      {
        "from": "src",
        "to": "runtime/src"
      },
      {
        "from": "scripts",
        "to": "runtime/scripts"
      },
      {
        "from": "studio",
        "to": "runtime/studio"
      },
      {
        "from": "index.html",
        "to": "runtime/index.html"
      }
    ],
    "directories": {
      "output": "release"
    },
    "extraMetadata": {
      "main": "dist/desktop/main.cjs"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Cut-Flow-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
